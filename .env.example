# Mailgun SMTP Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@domain.com
SMTP_PASSWORD=your-mailgun-smtp-password

# Email Settings
ALERT_FROM_EMAIL=your-email@domain.com
ALERT_FROM_NAME=Xentinel API Monitor
ALERT_TO_EMAILS=recipient1@example.com,recipient2@example.com

# Alert Configuration
ALERT_COOLDOWN_MINUTES=5

# API Endpoints (NEXT_PUBLIC_ are exposed to browser)
NEXT_PUBLIC_CCT_API_URL=http://localhost:5000/health/detailed
